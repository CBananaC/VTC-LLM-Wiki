      "cells": [
        {
          "column": "disorder",
          "text": "Light chain amyloidosis (AL)"
        },
        {
          "column": "pathological_basis",
          "text": "Increased production of monoclonal light chain"
        },
        {
          "column": "predisposing_conditions",
          "text": "Monoclonal gammopathies, including myeloma, benign gammopathies and plasmacytoma"
        },
        {
          "column": "other_features",
          "text": "Restrictive cardiomyopathy, peripheral and autonomic neuropathy, carpal tunnel syndrome, proteinuria, spontaneous purpura, amyloid nodules and plaques\nMacroglossia occurs rarely but is pathognomonic\nPrognosis is poor"
        }
